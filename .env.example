# Copy to .env and replace placeholder values. Never commit .env.

# --- General ---
ENVIRONMENT=development          # development | test | staging | production
LOG_LEVEL=INFO

# --- PostgreSQL ---
POSTGRES_DB=workshoppro
POSTGRES_USER=workshoppro
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Web (nginx edge: serves the app and /api) ---
WEB_PORT=3000
# 127.0.0.1 = this machine only. Use 0.0.0.0 to serve the local network (on-prem installs).
WEB_BIND=127.0.0.1
# Public URL used in email links.
APP_BASE_URL=http://localhost:3000
# Comma-separated list of browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secure (HTTPS-only) cookies. Leave empty to follow ENVIRONMENT: on in production, off otherwise.
COOKIE_SECURE=

# --- Email ---
# Defaults send to the bundled Mailpit (UI: http://localhost:8025). Set a real SMTP server
# for production. Keep SMTP_PASSWORD out of source control.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=WorkshopPro <no-reply@workshoppro.example>
MAILPIT_PORT=8025

# --- Object storage (photos, documents) ---
# Bundled SeaweedFS by default (internal only, not published). For a managed
# S3-compatible service set STORAGE_ENDPOINT_URL and these keys accordingly.
STORAGE_ACCESS_KEY=workshoppro
STORAGE_SECRET_KEY=change-me-local-only
STORAGE_BUCKET=workshoppro

# --- Running the backend outside Docker (uvicorn/pytest on the host) ---
# DATABASE_URL=postgresql+psycopg://workshoppro:change-me-local-only@localhost:5432/workshoppro
# REDIS_URL=redis://localhost:6379/0
